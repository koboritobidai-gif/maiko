# Tobidai Cockpit 環境変数サンプル
# 実際の値を書いたら `.env.local` にコピーして使用してください(.env.local は git 管理対象外)。
# 未設定の項目があっても、デモモード(DATA_MODE 未設定)であれば全機能がデモデータで動作します。

# --- Claude API ---------------------------------------------------------
# Anthropic の API キー。設定すると「AIに聞く/届ける/面談AI/提案書」の生成が Claude API 経由になる。
# 未設定でもルールベース(デモレスポンダ)で全機能が動作する。
ANTHROPIC_API_KEY=

# --- データモード ---------------------------------------------------------
# "live" にすると Google Sheets / Slack への実連携を試みる。未設定 or "demo" ならデモデータを使用する。
# live 指定時に認証情報が不足/接続に失敗した場合は自動でデモデータにフォールバックする
# (ダッシュボードのソースバッジが「接続エラー・デモ表示」になる。詳細は docs/SETUP.md 参照)。
DATA_MODE=demo

# --- Google スプレッドシート連携(DATA_MODE=live 時に使用) -------------------
# サービスアカウントの鍵JSON(ダウンロードしたファイルの中身をそのまま1行の文字列として貼り付ける)。
# private_key 内の改行は \n のままでも、実際の改行のままでもどちらでも動作する。
# 取得手順は docs/SETUP.md の 1章を参照。
GOOGLE_SERVICE_ACCOUNT_JSON=

# 対象スプレッドシートのID(URLの https://docs.google.com/spreadsheets/d/【ここ】/edit の部分)。
# 事前にサービスアカウントのメールアドレスへ「閲覧者」以上の権限でシートを共有しておくこと。
# タブ構成は docs/SHEET_TEMPLATE.md を参照。
SHEET_ID=

# --- Slack 連携(DATA_MODE=live 時に使用) ---------------------------------
# Slack App の Bot User OAuth Token(xoxb- から始まる)。
# 必要な Bot Token Scopes: chat:write / channels:history / channels:read / users:read
# 取得手順は docs/SETUP.md の 2章を参照。
SLACK_BOT_TOKEN=

# ダッシュボードの「Slack 最新ハイライト」で読みに行くチャンネルID(カンマ区切りで複数可)。
# チャンネルIDは Slack のチャンネル詳細画面下部などで確認できる(例: C0123ABCDEF)。
# 対象チャンネルには事前にボットを招待しておくこと。
SLACK_HIGHLIGHT_CHANNELS=

# 「届ける」でチャンネルを省略した場合の送信先チャンネルID(任意)。
SLACK_DEFAULT_CHANNEL=
