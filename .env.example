# uysot API access — copy to .env and fill in.
# NEVER commit .env (it is gitignored).

# Base URL of the confirmed data API host (Cloudflare-fronted, no bot-challenge).
UYSOT_API_BASE=https://mcpclient.app.uysot.uz/v1

# Bearer token (JWT). Short-lived — see README "Token refresh".
# Get it from DevTools > Network > any API request > Authorization header,
# or (once known) mint it via the login endpoint.
UYSOT_BEARER_TOKEN=

# Origin/referer the API expects (CORS).
UYSOT_ORIGIN=https://app.uysot.uz
