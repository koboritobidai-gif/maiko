# Tobidai Cockpit 環境変数サンプル
# 実際の値を書いたら `.env.local` にコピーして使用してください(.env.local は git 管理対象外)。
# 未設定の項目があっても、デモモード(DATA_MODE 未設定)であれば全機能がデモデータで動作します。

# --- Claude API ---------------------------------------------------------
# Anthropic の API キー。設定すると「AIに聞く/届ける/面談AI/提案書」の生成が Claude API 経由になる。
# 未設定でもルールベース(デモレスポンダ)で全機能が動作する。
ANTHROPIC_API_KEY=

# --- データモード ---------------------------------------------------------
# "live" にすると Google Sheets / Slack への実連携を試みる。未設定 or "demo" ならデモデータを使用する。
# live 指定時に認証情報が不足/接続に失敗した場合は自動でデモデータにフォールバックする
# (ダッシュボードのソースバッジが「接続エラー・デモ表示」になる。詳細は docs/SETUP.md 参照)。
DATA_MODE=demo

# --- Google スプレッドシート連携(DATA_MODE=live 時に使用) -------------------
# 認証情報の設定方法は2通り。どちらか一方だけ設定すればよい(FILE が優先される)。
#
# 方法A(おすすめ・簡単): ダウンロードした鍵JSONファイルをプロジェクト直下に
# 「service-account.json」という名前で置き、そのパスを指定する。貼り付け・1行化は不要。
# (service-account*.json は .gitignore 済みなので git には入らない)
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# 方法B: 鍵JSONファイルの中身をそのまま1行の文字列として貼り付ける。
# private_key 内の改行は \n のままでも、実際の改行のままでもどちらでも動作する。
# 取得手順は docs/SETUP.md の 1章を参照。
GOOGLE_SERVICE_ACCOUNT_JSON=

# 対象スプレッドシートのID(URLの https://docs.google.com/spreadsheets/d/【ここ】/edit の部分)。
# 事前にサービスアカウントのメールアドレスへ「閲覧者」以上の権限でシートを共有しておくこと。
# タブ構成は docs/SHEET_TEMPLATE.md を参照。
SHEET_ID=

# --- 集客・広告シート連携(DATA_MODE=live 時に使用) -------------------------
# 広告運用(アイドマ)シートのID。タブ「Google広告 」(末尾スペースあり)・「Meta広告」の日次実績を読み取る。
# 認証はGoogleスプレッドシート連携と共通(GOOGLE_SERVICE_ACCOUNT_FILE / GOOGLE_SERVICE_ACCOUNT_JSON)。
# サービスアカウントに「閲覧者」権限で共有しておくこと。手順は docs/SETUP.md の4章を参照。
MARKETING_AD_SHEET_ID=

# SNS運用(リズリアライズ)シートのID。タブ「週次トラッキング」の週次実績を読み取る。
# こちらもサービスアカウントに「閲覧者」権限で共有しておくこと。
MARKETING_SNS_SHEET_ID=

# SNS運用の月額固定費用(円)。数値のみ(カンマ・円マーク不要)。未設定時は 495000円。
MARKETING_SNS_MONTHLY_COST=495000

# --- Slack 連携(DATA_MODE=live 時に使用) ---------------------------------
# Slack App の Bot User OAuth Token(xoxb- から始まる)。
# 必要な Bot Token Scopes: chat:write / channels:history / channels:read / users:read
# 取得手順は docs/SETUP.md の 2章を参照。
SLACK_BOT_TOKEN=

# ダッシュボードの「Slack 最新ハイライト」で読みに行くチャンネルID(カンマ区切りで複数可)。
# チャンネルIDは Slack のチャンネル詳細画面下部などで確認できる(例: C0123ABCDEF)。
# 対象チャンネルには事前にボットを招待しておくこと。
SLACK_HIGHLIGHT_CHANNELS=

# 「届ける」でチャンネルを省略した場合の送信先チャンネルID(任意)。
SLACK_DEFAULT_CHANNEL=

# 求職者データベース(進捗管理)の読み取り先。#求職者チャンネル(公開チャンネル、1人の求職者につき
# 1スレッド運用)のチャンネルID。事前にボットを招待しておくこと(招待手順は docs/SETUP.md 2章参照)。
SLACK_CANDIDATE_CHANNEL=

# #請求書のチャンネルID。設定すると送客パートナー請求書の自動照合(ダッシュボードの
# 「請求書チェック」カード)が有効になる。未設定の間はこの機能自体が表示されない(機能OFF扱い)。
# Slackアプリに files:read スコープの追加とチャンネルへの招待が必要(手順は docs/SETUP.md 3章参照)。
SLACK_INVOICE_CHANNEL=

# --- 送客売上シート連携(DATA_MODE=live 時に使用) ---------------------------
# 送客売上(翔び台が紹介先企業から「貰う」金額)シートのID。入金月ごとにタブを分けて記録する運用で、
# タブ名「2026年6月」形式(=対象月。入金は翌月末)のタブを自動で読み取る。
# 設定すると「送客売上(貰う金額)」セクションが有効になる。未設定の間はこの機能自体が表示されない
# (機能OFF扱い)。サービスアカウントに「閲覧者」権限で共有しておくこと(手順は docs/SETUP.md 6章参照)。
REVENUE_SHEET_ID=

# --- 営業実績連携(DATA_MODE=live 時に使用) ---------------------------------
# #21_ra チャンネルのID。ワークフローbot「架電数報告(12時/15時)」スレッドの返信から架電数を、
# 「業務報告)8/17」スレッドの返信から商談数・契約数を自動集計する(「業務予定報告」スレッドは
# 実績ではないため集計対象外)。設定すると「営業実績」セクションが有効になる。SLACK_RA_CHANNEL・
# SLACK_APPOINTMENT_CHANNEL がどちらも未設定の間はこの機能自体が表示されない(機能OFF扱い)。
# SLACK_APPOINTMENT_CHANNEL とは独立して設定可能(片方のみでも動作)。招待手順・詳細仕様は
# docs/SETUP.md の7章を参照。
SLACK_RA_CHANNEL=

# #22_アポイント報告 チャンネルのID。1投稿=アポ獲得1件として自動集計する(獲得経路は本文または
# スレッド返信の「経路:」表記・括弧書きから読み取る)。SLACK_RA_CHANNEL とは独立して設定可能。
SLACK_APPOINTMENT_CHANNEL=

# --- 企業・求人ページ連携(DATA_MODE=live 時に使用) ---------------------------
# CAが管理する2つのスプレッドシートのID。求人マトリックス/送客可能企業リストのどちらのIDを
# どちらの変数に入れても、シートのタイトルから自動判別するため入れ違いでも問題ない
# (詳細は src/lib/adapters/company-directory.ts のコメント参照)。
# どちらか一方でも設定すると企業・求人ページが有効になる(未設定の間はセットアップ手順を表示)。
# 送客可能企業リストは状態変更・企業追加をアプリから書き込むため、サービスアカウントに
# 「編集者」権限で共有すること(求人マトリックス側は読み取り専用のため閲覧者権限のみでよい)。
JOB_MATRIX_SHEET_ID=
REFERRAL_COMPANY_SHEET_ID=

# --- パスワード保護(公開サーバーに置く場合) --------------------------------
# 公開サーバー(Vercelなど)に置く場合のBasic認証パスワード。ユーザー名は何でもよい。
# 未設定ならローカル開発と同様に認証なしで全ページ・APIにアクセスできる。
APP_PASSWORD=
