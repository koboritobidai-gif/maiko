# ── データベース ──────────────────────────────
# 既定はローカルの SQLite ファイル。Vercel などにデプロイする場合は
# Turso (libSQL) の URL とトークンを設定する。
DATABASE_URL=file:./data/maiko.db
# DATABASE_AUTH_TOKEN=

# ── セッション ────────────────────────────────
# 必須。openssl rand -hex 32 などで生成した値を設定する。
SESSION_SECRET=change-me-to-a-random-32-byte-hex-string

# ── メール通知（社内ツールがメールのため必須）────
MAIL_FROM="フェース タスク管理 <task@example.co.jp>"
SMTP_HOST=smtp.example.co.jp
SMTP_PORT=587
SMTP_USER=task@example.co.jp
SMTP_PASSWORD=
# 未設定なら送信せずログ出力のみ（動作確認用）
MAIL_DRY_RUN=1

# 期限の何日前から通知するか
REMIND_DUE_SOON_DAYS=3
# 何日更新がないと「状況未報告」として通知するか
REMIND_STALE_DAYS=7

# ── 定期実行 ──────────────────────────────────
# /api/cron/reminders を叩くときの Bearer トークン
CRON_SECRET=

# ── 初期管理者（seed で使用）──────────────────
SEED_ADMIN_EMAIL=admin@face.example.co.jp
SEED_ADMIN_PASSWORD=

# ── 議事録の取り込み ──────────────────────────
# 何日ぶんさかのぼって取り込むか
MINUTES_LOOKBACK_DAYS=14
# 議事録と判定するキーワード（件名・ファイル名・投稿本文）
MINUTES_KEYWORDS=議事録,議事メモ,MTGメモ,ミーティングメモ,打ち合わせメモ,minutes

# メール（IMAP）。件名にキーワードを含むメールを取り込む
MINUTES_IMAP_HOST=imap.example.co.jp
MINUTES_IMAP_PORT=993
MINUTES_IMAP_SECURE=1
MINUTES_IMAP_USER=
MINUTES_IMAP_PASSWORD=
MINUTES_IMAP_MAILBOX=INBOX
# ここに挙げた宛先に送られた議事録は、役員限定タスクとして取り込む
MINUTES_MAIL_EXEC_TO=

# Slack。ボットトークンと、議事録を投稿しているチャンネルID
MINUTES_SLACK_TOKEN=
MINUTES_SLACK_CHANNELS=
MINUTES_SLACK_EXEC_CHANNELS=
# 議事録専用チャンネルなら 1 にしてキーワード判定を省く
MINUTES_SLACK_ALL=0

# Google ドライブ（Google ドキュメント）。サービスアカウントで読み取る
MINUTES_DRIVE_CLIENT_EMAIL=
MINUTES_DRIVE_PRIVATE_KEY=
MINUTES_DRIVE_FOLDERS=
MINUTES_DRIVE_EXEC_FOLDERS=
# フォルダ内のドキュメントを名前で絞らずすべて対象にする
MINUTES_DRIVE_ALL=1
