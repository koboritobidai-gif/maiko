# ── データベース ──────────────────────────────
# 既定はローカルの SQLite ファイル。Vercel などにデプロイする場合は
# Turso (libSQL) の URL とトークンを設定する。
DATABASE_URL=file:./data/maiko.db
# DATABASE_AUTH_TOKEN=

# ── セッション ────────────────────────────────
# 必須。openssl rand -hex 32 などで生成した値を設定する。
SESSION_SECRET=change-me-to-a-random-32-byte-hex-string

# ── メール通知（社内ツールがメールのため必須）────
MAIL_FROM="フェース タスク管理 <task@example.co.jp>"
SMTP_HOST=smtp.example.co.jp
SMTP_PORT=587
SMTP_USER=task@example.co.jp
SMTP_PASSWORD=
# 未設定なら送信せずログ出力のみ（動作確認用）
MAIL_DRY_RUN=1

# 期限の何日前から通知するか
REMIND_DUE_SOON_DAYS=3
# 何日更新がないと「状況未報告」として通知するか
REMIND_STALE_DAYS=7

# ── 定期実行 ──────────────────────────────────
# /api/cron/reminders を叩くときの Bearer トークン
CRON_SECRET=

# ── 初期管理者（seed で使用）──────────────────
SEED_ADMIN_EMAIL=admin@face.example.co.jp
SEED_ADMIN_PASSWORD=
